PROJECT_NAME="G-Scores Web API"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gscores

# Hoac su dung connection string truc tiep (vi du tren Render/Railway/Supabase/Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gscores

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
