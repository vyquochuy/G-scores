# Application Settings
PROJECT_NAME="G-Scores Web API"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=gscores

# Direct Connection URL (Local / Cloud PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/gscores

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=0.5

# CORS Origins

BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
